# ============================================================
# Streamlit secrets template — hk-stock-monitor
# ------------------------------------------------------------
# LOCAL (dev): copy this file to `.streamlit/secrets.toml` and fill values.
#   .streamlit/secrets.toml is GITIGNORED (never commit real secrets).
#
# STREAMLIT CLOUD: put these in Dashboard -> Settings -> Secrets
#   (same key names, one per line).
#
# These are OPTIONAL: the dashboard runs fully without Supabase.
# ============================================================

SUPABASE_URL = "https://<your-project-ref>.supabase.co"
# Service-role key (server-side only, bypasses RLS, KEEP SECRET).
# Do NOT use the public anon key here for writes.
SUPABASE_SERVICE_ROLE_KEY = ""

# Optional: default lookback candles for the data fetcher.
# DATA_LOOKBACK = "120"
