# ============================================================
# hk-stock-monitor - environment template
# Copy to `.env` (gitignored) and fill real values.
# Vercel: set these as Environment Variables in project settings.
# ============================================================

# --- Supabase ---
# Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Project API key. Use the "anon" public key for client-side reads.
SUPABASE_ANON_KEY=
# Service-role key for server-side writes (KEEP SECRET, server only).
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: news scrape fallback target ---
# Only used if you swap the default news source.
NEWS_FALLBACK_BASE_URL=https://www.aastocks.com

# --- Runtime ---
# Number of historical candles to pull (default 120).
DATA_LOOKBACK=120
# Auto-monitor polling interval in seconds (serverless-friendly: keep >= 300).
MONITOR_POLL_SECONDS=300
